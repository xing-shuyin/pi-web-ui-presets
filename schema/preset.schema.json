{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://raw.githubusercontent.com/xing-shuyin/pi-web-ui-presets/main/schema/preset.schema.json",
	"title": "pi-web-ui shareable settings preset",
	"type": "object",
	"required": ["format", "version", "name", "settings"],
	"additionalProperties": true,
	"properties": {
		"format": {
			"const": "pi-web-ui-preset"
		},
		"version": {
			"const": 1
		},
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 60,
			"description": "预设名（导入时若已存在同名预设会被覆盖）"
		},
		"description": {
			"type": "string",
			"maxLength": 500
		},
		"author": {
			"type": "string",
			"maxLength": 80
		},
		"tags": {
			"type": "array",
			"maxItems": 8,
			"items": { "type": "string", "maxLength": 24 }
		},
		"createdAt": {
			"type": "string",
			"description": "ISO-8601 时间戳"
		},
		"appVersion": {
			"type": "string"
		},
		"enabledTools": {
			"type": "array",
			"maxItems": 200,
			"items": { "type": "string" }
		},
		"plugins": {
			"type": "array",
			"maxItems": 32,
			"description": "Optional plugin requirements; installation requires user consent. No plugin settings or secrets.",
			"items": {
				"type": "object",
				"required": ["id"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" },
					"name": { "type": "string", "maxLength": 100 },
					"source": { "type": "string", "maxLength": 300 },
					"version": { "type": "string", "maxLength": 60 }
				}
			}
		},
		"settings": {
			"type": "object",
			"description": "与 pi-web-ui 设置预设一一对应的字段（见 pi-web-ui 仓库 server/client-state.ts 的 SettingsPreset）。未知字段会被导入端忽略。",
			"additionalProperties": true
		}
	}
}
